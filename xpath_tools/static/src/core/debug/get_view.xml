<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="xpath_tools.GetView">
        <style>
            .mb-half{margin-bottom: 0.5rem;}
            .copy-btn{cursor: pointer; padding:0 2px 0 2px;}
        </style>
        <pre t-esc="props.arch" t-on-mouseup="pointerUpArch"/>
        <group>
            <textarea class="o_input"
                      t-att-placeholder="props.placeholder.input_xml"
                      t-att-value="state.input_xml"
                      t-on-input="(event) => this.setInputXml(event.target.value)"/>

            <t t-if="state.output_xpath_error">
                <pre t-esc="state.output_xpath_error"/>
            </t>
            <t t-elif="state.output_xpath">
                <t t-foreach="state.output_xpath" t-as="xpath" t-key="xpath">
                    <pre class="mb-half"><sup class="text-info copy-btn" t-on-click="() => _onCopyClickXPath(xpath)"><i class="fa fa-copy"/></sup><span class="ml8" t-esc="xpath"/></pre>
                </t>
            </t>
            <t t-else="">
                <pre t-esc="props.placeholder.output_xpath"/>
            </t>
        </group>
        <group>
            <textarea class="o_input mt-4"
                      t-att-placeholder="props.placeholder.input_xpath"
                      t-att-value="state.input_xpath"
                      t-on-input="(event) => this.setInputXpath(event.target.value)"/>

            <t t-if="state.output_xml_error">
                <pre t-esc="state.output_xml_error"/>
            </t>
            <t t-elif="state.output_xml">
                <t t-foreach="state.output_xml" t-as="xml" t-key="xml">
                    <pre class="mb-half" t-esc="xml"/>
                </t>
            </t>
            <t t-else="">
                <pre t-esc="props.placeholder.output_xml"/>
            </t>
        </group>
    </t>

    <t t-inherit="web.DebugMenu.GetViewDialog" t-inherit-mode="extension">
        <xpath expr="//pre" position="replace">
            <t t-call="xpath_tools.GetView"/>
        </xpath>
    </t>

</templates>

