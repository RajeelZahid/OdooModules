<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="field_technical_name.field_label">
        <t t-if="isDebugMode">
            <t t-set="field_label" t-value="column.string + ' (' + column.name + ')'"/>
        </t>
        <t t-else="">
            <t t-set="field_label" t-value="column.string"/>
        </t>
        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1"
              t-att-class="isNumeric ? 'o_list_number_th' : ''"
              t-raw="field_label"/>
    </t>

    <t t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//span[@t-esc='column.label']" position="replace">
            <t t-call="field_technical_name.field_label"/>
        </xpath>
    </t>

    <t t-inherit="account.FileUploadListRenderer" t-inherit-mode="extension">
        <xpath expr="//span[@t-esc='column.label']" position="replace">
            <t t-call="field_technical_name.field_label"/>
        </xpath>
    </t>

