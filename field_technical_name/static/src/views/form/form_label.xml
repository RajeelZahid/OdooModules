<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-inherit="web.FormLabel" t-inherit-mode="extension">
        <xpath expr="//label/t" position="replace">
            <t t-esc="props.string"/>
            <t t-if="isDebugMode">
                (<t t-esc="props.fieldInfo.name"/>
                <sup class="text-info" style="cursor: pointer;padding:0 2px 0 2px"
                     t-on-click="_onCopyClick">
                    <i class="fa fa-copy"/>
                </sup>)</t>
        </xpath>
    </t>
</templates>
