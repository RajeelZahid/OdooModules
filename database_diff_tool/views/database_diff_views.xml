<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_database_diff_list" model="ir.ui.view">
        <field name="name">database.diff.list</field>
        <field name="model">database.diff</field>
        <field name="arch" type="xml">
            <list string="Database Diff Reports">
                <field name="name"/>
                <field name="subject_db_url"/>
                <field name="target_db_url"/>
                <button name="action_open_lines" type="object" string="Open Lines" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_database_diff_form" model="ir.ui.view">
        <field name="name">database.diff.form</field>
        <field name="model">database.diff</field>
        <field name="arch" type="xml">
            <form string="Database Diff Report">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-cubes"
                                context="{'diff_type': 'module'}"
                                invisible="module_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="module_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Modules
                                </span>
                            </div>
                        </button>

                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-table"
                                context="{'diff_type': 'model'}"
                                invisible="model_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="model_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Models
                                </span>
                            </div>
                        </button>

                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-columns"
                                context="{'diff_type': 'field'}"
                                invisible="field_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="field_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Fields
                                </span>
                            </div>
                        </button>

                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bars"
                                context="{'diff_type': 'menu'}"
                                invisible="menu_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="menu_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Menus
                                </span>
                            </div>
                        </button>

                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-eye"
                                context="{'diff_type': 'view'}"
                                invisible="view_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="view_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Views
                                </span>
                            </div>
                        </button>

                        <button name="action_open_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th-large"
                                invisible="total_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_count"/>
                                </span>
                                <span class="o_stat_text">
                                    Total
                                </span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="subject_db_url" widget="url" readonly="1"/>
                            <field name="target_db_url" widget="url" readonly="1"/>
                        </group>
                    </group>

                </sheet>
            </form>

        </field>
    </record>

    <record id="action_database_diff" model="ir.actions.act_window">
        <field name="name">Database Diff Reports</field>
        <field name="res_model">database.diff</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
