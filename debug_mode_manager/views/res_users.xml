<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form" model="ir.ui.view">
            <field name="name">res.users.form.debugging</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']/group" position="before">
                    <group string="Debugging">
                        <field name="default_debug_mode" widget="radio"/>
                        <field name="default_debug_mode_value" invisible="default_debug_mode != 'multiple'"
                               placeholder="Define multiple values for debug mode (comma separated). e.g. assets,tests"/>
                        <field name="allow_force_debug"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>