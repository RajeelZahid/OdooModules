<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shared_recs_link_wizard_view_form" model="ir.ui.view">
        <field name="name">shared.recs.link.wizard.form</field>
        <field name="model">shared.recs.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Shared Records">
                <div>
                    <div>
                        <button name="view_records" type="object" string="View Records"/>
                    </div>
                </div>
                <footer>
                    <button string="Close"
                            class="btn btn-secondary rounded-2"
                            special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shared_recs_link_wizard" model="ir.actions.act_window">
        <field name="name">Shared Records</field>
        <field name="res_model">shared.recs.link.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="shared_recs_link_wizard_view_form"/>
        <field name="target">new</field>
        <field name="path">shared-link</field>
    </record>
</odoo>
