<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_view_form" model="ir.ui.view">
        <field name="name">xpath.tools.ir.ui.view.form</field>
        <field name="model">ir.ui.view</field>
        <field name="inherit_id" ref="base.view_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <button string="Computed Arch" special="add" help="Computed arch for current view"
                            id="xpath-tools-computed-view" class="btn-primary"/>
                    <button string="Open XPath Tool" special="add" help="Open XPath tool for current view"
                            id="xpath-tools-one-view" class="btn-primary"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>